# deepinfer-bridge — example environment.
#
# Copy to `.env` and adjust. NOTE: the bridge does NOT read `.env` itself — there is no
# dotenv dependency. Export these variables in your shell, or let your process manager /
# container runtime inject them.
#
# Every BridgeConfig field can be set as DEEPINFER_BRIDGE_<FIELD_NAME>. Precedence is:
#   CLI flag  >  environment variable  >  built-in default
#
# Nothing here is a real credential. Never commit a filled-in .env (it is gitignored).

# --- serving -----------------------------------------------------------------
DEEPINFER_BRIDGE_HOST=127.0.0.1
DEEPINFER_BRIDGE_PORT=8000
DEEPINFER_BRIDGE_SERVED_MODEL_NAME=deepseek-v4.1-flash

# Required as soon as you bind beyond loopback. Generate one with: openssl rand -hex 32
# An empty value is a startup error (it would otherwise silently disable authentication).
DEEPINFER_BRIDGE_API_KEY=

DEEPINFER_BRIDGE_MAX_OUTSTANDING=256
DEEPINFER_BRIDGE_STARTUP_TIMEOUT_S=3600
DEEPINFER_BRIDGE_REQUEST_TIMEOUT_S=600
DEEPINFER_BRIDGE_SHUTDOWN_GRACE_S=30
DEEPINFER_BRIDGE_MAX_BODY_BYTES=8388608

DEEPINFER_BRIDGE_LOG_LEVEL=info
# "text" (key=value) or "json"
DEEPINFER_BRIDGE_LOG_FORMAT=text
# Leave false in production: prompt and completion text is not logged by default.
DEEPINFER_BRIDGE_LOG_PROMPTS=false
# Only ever set true for an isolated, trusted network.
DEEPINFER_BRIDGE_INSECURE=false

# --- model -------------------------------------------------------------------
# Honoured for the default model id, exactly as in DeepInfer's examples.
DEEPINFER_HF_MODEL_DIR=/models/DeepSeek-V4.1-Flash-1017
# Path to a DeepInfer checkout if it is not pip-installed.
DEEPINFER_BRIDGE_DEEPINFER_ROOT=/path/to/DeepInfer
# true = canned replies through the real protocol stack, no GPU required.
DEEPINFER_BRIDGE_MOCK=false

# --- parallelism (must satisfy: cp divides ep, and dp * cp is a multiple of ep) ---
DEEPINFER_BRIDGE_EP=8
DEEPINFER_BRIDGE_CP=1
# Defaults to ep // cp.
# DEEPINFER_BRIDGE_DP=

# --- engine limits -----------------------------------------------------------
DEEPINFER_BRIDGE_MAX_MODEL_LEN=32768
DEEPINFER_BRIDGE_MAX_NUM_BATCHED_TOKENS=32768
DEEPINFER_BRIDGE_MAX_NUM_SEQS=32
DEEPINFER_BRIDGE_GPU_MEMORY_UTILIZATION=0.85

# --- tests -------------------------------------------------------------------
# Required by the test suite and by --mock. Without it every test SKIPS.
# deepseek-recipe/static/tokenizers/v41/tokenizer.json
DEEPSEEK_RECIPE_TOKENIZER=
